  },
  "devDependencies": {
    "@types/express":      "^4.17.0",
    "@types/cors":         "^2.8.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/pg":           "^8.10.0",
    "@types/node":         "^22.0.0",
    "typescript":          "^5.7.0",
    "ts-node-dev":         "^2.0.0"
  }
